# Локальная конфигурация с реальными credentials - никогда не коммитим
app/config/config_db.php

# Дампы БД (реальные пользовательские данные: email, хэши паролей и т.д.)
*.sql
*.sql.gz

# Логи приложения (содержат пользовательские/отладочные данные)
/logs/*.log
!/logs/.gitkeep

# Composer: внешние зависимости восстанавливаются через `composer install`.
# Исключение - vendor/fw: это собственный код проекта (кастомный MVC-фреймворк),
# подключенный через PSR-4 в composer.json, поэтому он остается в репозитории.
/vendor/*
!/vendor/fw/

# Временные/служебные файлы
*.tmp
*.swp
*.bak

# IDE
/.idea/
/.vscode/

# ОС
.DS_Store
Thumbs.db
